# Public client values (the anon key is safe to ship in a browser build; access is
# guarded by RLS + the SECURITY DEFINER function in supabase/views.sql).
# Copy to .env for local `npm run dev`. For the GitHub Pages build these live as
# repository Variables (Settings -> Secrets and variables -> Actions -> Variables).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
